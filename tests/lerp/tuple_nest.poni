fun init() {
    var a = (0.0, (0.0, 0.0), (0.0,));
    var b = (1.0, (1.0, 1.0), (1.0,));

    print(lerp(a, b, 0.25));  //! (0.250000, (0.250000, 0.250000), (0.250000,))
    print(lerp(a, b, 0.75));  //! (0.750000, (0.750000, 0.750000), (0.750000,))

    print(lerp(a, b, false)); //! (0.000000, (0.000000, 0.000000), (0.000000,))
    print(lerp(a, b, true )); //! (1.000000, (1.000000, 1.000000), (1.000000,))
}