fun init() {
    print(10 % 5); //! 0
    print(9 % 5);  //! 4

    // Stolen from Rust :)
    // Unfortunately the parser is not quite behaving correctly.
    print((-7) % 4);  //! 1
    print(7 % -4);    //! 3
    print((-7) % -4); //! 1
    
    print(10.0 % 5.0); //! 0.000000
    print(8.0 % 5.0);  //! 3.000000

    print((10, 9, 8) % 5); //! (0, 4, 3)
    print((10.0, 9.0) % 5); //! (0.000000, 4.000000)
}