fun tester(v: bool) {
	// Right now, this is getting parsed something like:
	// if (v) { left } else { right(); }
	// Although for some reason that results in an Unbound not getting bound.
	// But still...
	//
	// I suppose we need some kind of "parse block but it should end at the
	// block" rule.
	if v { left } else { right }();
}

fun left() {
	print("left");
}

fun right() {
	print("right");
}

fun init() {
	tester(true);  //! left
	tester(false); //! right
}