fun test() -> fun() {
	var a = 10;

	var helper = fun(b: int) {
		print(a + b);
	};

	var uses_helper = fun() {
		helper(2);
		helper(4);

		a = 15;
		helper(6);
	};

	return uses_helper;
}

fun init() {
	var f = test();
	//! 12
	//! 14
	//! 21
	f();
	//! 17
	//! 19
	//! 21
	f();
}