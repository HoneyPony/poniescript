fun evil(e: Example) -> int {
    return e.b + 20;
}

class Example {
    // This is. apparently, OK actually.
    //
    // TODO: It would not be OK if our 'self' value *escaped*,
    // i.e. was assigned anywhere. To be safe, we may want to
    // completely forbid reading 'self' at all in initializing
    // expressions.
    //
    // Also TODO: We miscompile this. >:( Our code doesn't detect
    // that 'b' needs to be initialized first, because we don't
    // realize that evil() is reading from it. Probably the best
    // thing to do is to simply forbid 'self' in any of our
    // initializers; that would mean this test case would error,
    // but that's OK.
    var a1 = evil(self);

    var b = 10;
}

fun init() {
    var e = new Example{};
    print(e.a1, " ", e.b); //! 30 10
}