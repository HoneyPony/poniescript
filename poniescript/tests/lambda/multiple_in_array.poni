fun init() {
    var funs = [
        |x: int| -> int { x + 5 }, // Current type inference rules require at least one with a real type.
        |x| x * 20,
        |x| 4 - x,
    ];

    var funs2 = [
        |x| x + 6,
        |x| x * 30,
        |x: int| -> int { 8 - x }, // But it does not have to be the first...
    ];

    //! 15
    //! 16
    //! 200
    //! 300
    //! -6
    //! -2
    for i in 0..3 {
        print(funs[i](10));
        print(funs2[i](10));
    }
}