class Example {
    // TODO: I guess it would be better if we only reported this error once,
    // but whatever.

    //? Cycle in variable initialization order
    //? Cycle in variable initialization order
    var a = test(b, c);
    var b = 10;
    var c = d;
    var d = test(b, a);
}

fun test(x: int, y: int) -> int {
    return x * y;
}

