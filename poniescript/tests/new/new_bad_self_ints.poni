class Grid {
    var width : int    = 0;
    var height: int    = 0;

    fun clone_grid() -> Grid {
        // The problem: The codegen, when this test was written, would essentially
        // treat 'self' as the new object when reading from width, which of course,
        // is uninitialized because it is the new object.
        new Grid {
            width: width,
            height: height,
        }
    }
}

fun init() {
    var grid = new Grid {
        width: 23,
        height: 72,
    };

    var clone = grid.clone_grid();
    print(clone.width, " ", clone.height); //! 23 72
}
