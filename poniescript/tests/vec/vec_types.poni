fun init() {
    var x: vec2 = (1, 2);
    var y: vec3 = (1, 2, 3);
    var z: vec4 = (1, 2, 3, 4);

    var xi: vec2i = (4, 5);
    var yi: vec3i = (4, 5, 6);
    var zi: vec4i = (4, 5, 6, 7);

    print(x);  //! (1.000000, 2.000000)
    print(y);  //! (1.000000, 2.000000, 3.000000)
    print(z);  //! (1.000000, 2.000000, 3.000000, 4.000000)

    print(xi); //! (4, 5)
    print(yi); //! (4, 5, 6)
    print(zi); //! (4, 5, 6, 7)
}