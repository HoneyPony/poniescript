trait Iterator[T] {
    fun next() -> Option[T];
}

// vs

fun my_iter() -> Option[T] { ... }

// in particular...

class Thing {
    fun iter() -> Iterator[int] {
        class It {
            impl Iterator[T] {
                fun next() -> Option[int] {
                    None
                }
            }
        }

        return new It;
    }
}

// vs...

class Thing {
    var number: int = 20;

    fun iter() -> Iterator[int] {
        var x = 0;
        fun() -> Option[int] {
            var prev = x;
            x += 1;
            if prev < number { Some(x) } else { None };
        }
    }
}

