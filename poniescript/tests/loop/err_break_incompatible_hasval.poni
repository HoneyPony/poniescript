fun f(i: int) -> int {
    loop {
        i = i + 1;
        if i >= 7 {
            break 30;
        }
        if i >= 5 {
            break 20;
        }
        if i >= 3 {
            //? Incompatible breaks in loop: either all breaks must provide a value, or no breaks.
            break;
        }
    }
}

fun g(i: int) -> int {
    loop {
        i = i + 1;
        if i >= 7 {
            break;
        }
        if i >= 5 {
            break 5;
        }
        if i >= 3 {
            //? Incompatible breaks in loop: either all breaks must provide a value, or no breaks.
            break;
        }
    }
}

fun init() {
    print(f(2)); //! 10
    print(f(3)); //! 10
    print(f(5)); //! 20
    print(f(7)); //! 30
}