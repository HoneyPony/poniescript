fun make_funs() -> DynArray[fun() -> int] {
    var funs: DynArray[fun() -> int] = [];

    var i_ = 0;
    while i_ < 5 {
        // Must create a new binding to i inside the loop. This is the most
        // consistent way to make this make sense.
        var i = i_;

        funs.push(fun() -> int {
            return i * i;
        });

        // Note: We need to increment the OUTER i variable. So they actually
        // have to have different names.
        i_ += 1;
    }

    funs
}

fun init() {
    var funs = make_funs();

    //! 0
    //! 1
    //! 4
    //! 9
    //! 16
    for i in 0..funs.length {
        print(funs[i]());
    }
}