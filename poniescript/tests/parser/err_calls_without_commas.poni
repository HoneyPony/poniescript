fun a(x: int, y: int) {}

fun init() {
    //? Expected ',', got '2'
    a((1) 2);

    var b = a;
    //? Expected ',', got '2'
    b((1) 2);

    //? Expected ',', got '2'
    var q = [(1) 2];

    //? Expected ',', got '2'
    print((1) 2);

    //? Expected ',', got '2'
    str((1) 2);

    //? Expected ',', got 'int'
    var z: fun(int int) = a;
}

