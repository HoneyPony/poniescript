class D {
    var val1: int = 10;
    var val2: int = 20;
    var val3: StrConst = "meow";
}

class C {
    var the_d = new D {};
}

class B {
    var the_c = new C {};
}

class A {
    var the_b = new B {};
}

fun init() {
    var the_a = new A {};
    var the_b = the_a.the_b;
    var the_c = the_b.the_c;
    var the_d = the_c.the_d;

    print(the_d.val1);
    print(the_d.val2);
    print(the_d.val3);
}