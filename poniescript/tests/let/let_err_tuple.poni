// To correctly typecheck this program, we have to realize that Sets on a value
// type accessor cannot be allowed to happen, if that value type is itself
// readonly.

let my_tuple = (20, 30);

class MyClass {
    let tuple = (30, 40, 50);
}

class Horse{}

fun init() {
    //? Invalid assignment to variable 'my_tuple', which cannot be written to.
    my_tuple.x = 40;

    var instance = new MyClass{};
    //? Invalid assignment to property 'tuple', which cannot be written to.
    instance.tuple.y = 5;

    let nested_tuple = ((10, 20), 30);
    //? Invalid assignment to variable 'nested_tuple', which cannot be written to.
    nested_tuple.0.0 = 25;

    let horse = (new Horse{}, 5);
    //? Invalid assignment to variable 'horse', which cannot be written to.
    horse.0 = new Horse{};
}