fun init() {
    var arr: DynArray[int] = [1, 2, 3];
    var arr2 = arr;

    print(arr[0], " ", arr[1], " ", arr[2]); //! 1 2 3
    arr2[1] = 5;
    print(arr[0], " ", arr[1], " ", arr[2]); //! 1 5 3

    arr2.push(7);
    // New element shows up in 'arr' 
    print(arr[0], " ", arr[1], " ", arr[2], " ", arr[3]); //! 1 5 3 7

    arr2 = arr.clone_shallow();
    print(arr2[0], " ", arr2[1], " ", arr2[2], " ", arr2[3]); //! 1 5 3 7

    arr2[0] = 20;
    arr2[1] = 30;
    arr2[2] = 40;

    print(arr2[0], " ", arr2[1], " ", arr2[2], " ", arr2[3]); //! 20 30 40 7
    // Old array is unmodified
    print(arr[0], " ", arr[1], " ", arr[2], " ", arr[3]); //! 1 5 3 7

    arr2.push(42);
    print(arr2[0], " ", arr2[1], " ", arr2[2], " ", arr2[3], " ", arr2[4]); //! 20 30 40 7 42

    arr.push(16);
    print(arr[0], " ", arr[1], " ", arr[2], " ", arr[3], " ", arr[4]); //! 1 5 3 7 16
}