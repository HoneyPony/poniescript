class Base {
    var x: int;
    var y: int;
}

class Subclass : Base {
    var z: int;
}

fun init() {
    var sub = new Subclass {
        super: {
            //? Invalid assignment to 'x': need int, but value is StrConst
            x: "hello",
            y: 30,
        },
        z: 50
    };

    print(sub.x); //! 0
    print(sub.y); //! 30
    print(sub.z); //! 50
}