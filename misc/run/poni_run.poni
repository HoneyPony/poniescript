var global = 15; // this will not be re-called. globals keep their value.

class Horse {
    var hooves = 4;

    fun neigh() {
        print("neigh! i have ", hooves, " hooves");
    }

    fun walk() {
        hooves = hooves + 1;
    }
}

var the_horse = new Horse{};

fun init() {
    print("this will only ever be called once");
}

fun tick() {
    //print("hooves = ", the_horse.hooves);
    the_horse.neigh();
    print("global = ", global);
    //the_horse.walk();
}