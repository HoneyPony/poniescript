fun first(x: int) -> int  { print("first ", x);  x + 1 }
fun second(x: int) -> int { print("second ", x); x * 2 }
fun third(x: int) -> int  { print("third ", x);   x * x }

fun init() {
    var arr = [
        first,
        second,
        third
    ];

    print(arr[0](1)); //! first 1
                      //! 2
    print(arr[0](2)); //! first 2
                      //! 3
    print(arr[0](3)); //! first 3
                      //! 4

    print(arr[1](1)); //! second 1
                      //! 2
    print(arr[1](2)); //! second 2
                      //! 4
    print(arr[1](3)); //! second 3
                      //! 6

    print(arr[2](1)); //! third 1
                      //! 1
    print(arr[2](2)); //! third 2
                      //! 4
    print(arr[2](3)); //! third 3
                      //! 9
}