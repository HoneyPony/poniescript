fun print_three(arr: Array[int]?) {
    var arr = arr else { print("nil"); return; };
    print(arr[0], " ", arr[1], " ", arr[2]);
}

fun init() {
    //! nil
    print_three(nil);
    //! 1 2 3
    print_three([1, 2, 3]);
    var arr = [4, 5, 6];
    //! 4 5 6
    print_three(arr);

    // This had been part of this test case, but the compiler complains
    // that else can't apply to [7, 8, 9], which seems legit...
    //arr = [7, 8, 9] else { return; };
    // //! 7 8 9
    //print_three(arr);
}