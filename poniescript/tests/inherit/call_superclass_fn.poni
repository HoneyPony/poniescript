class Base {
    var x: int = 20;
    var y: int = 30;

    fun print_stuff() {
        print(x, " ", y);
    }
}

class Sub : Base {
    fun helper() {
        x += 5;
        y += 5;
        print_stuff();
    }
}

fun init() {
    var sub = new Sub{};
    sub.print_stuff(); //! 20 30
    sub.helper(); //! 25 35
}