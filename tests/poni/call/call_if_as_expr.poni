fun tester(v: bool) {
	// Note that for this to parse correctly requires the If parser to expect
	// a block(), not an expression() (because expression() will eat the call).
	if v { left } else { right }();
}

fun left() {
	print("left");
}

fun right() {
	print("right");
}

fun init() {
	tester(true);  //! left
	tester(false); //! right
}