class Outer {
    var hello: int = 5;

    class Inner {
        var xyz: int = 20;

        fun getter() -> fun() {
            //? Identifier 'my_fun' is not available in this scope.
            my_fun
        }
    }

    fun my_fun() {
        print(hello);
    }
}

fun init() {
    var outer = new Outer{};
    var inner = new Outer.Inner{};

    var callback = inner.getter();
    callback(); //! 5
}