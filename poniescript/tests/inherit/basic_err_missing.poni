class Base {
    var x: int;
    var y: int;
}

class Subclass : Base {
    var z: int;
}

fun init() {
    //? 'new' expression is missing initializer for mandatory variable 'x' (from superclass 'Base')
    var sub = new Subclass {
        super: {
            y: 30,
        },
        z: 50
    };

    print(sub.x);
    print(sub.y);
    print(sub.z);
}