class Horse {
    var name = "bailey";
}

fun printer(x: Horse?) {
    // Note that the type here can be inferred because 'x' has a real type,
    // so the 'else' expression gets a type, so the variable gets a type.
    var y = x else return;
    print(y.name);
}

fun init() {
    printer(nil);
    printer(new Horse{}); //! bailey
    printer(new Horse { name: "alex" }); //! alex
}