fun init() {
    var arr = [1.0, 2.0, 3.0];

    var second = [4, 5, 6];

    // Should fail because we can't promote an actual array. We can only
    // promote array literals (i.e. compile-time instead of Expr::Promote)

    //? Invalid promotion from Array[int] to Array[float].
    arr = second;

    print(arr[0]);
    print(arr[1]);
    print(arr[2]);
}