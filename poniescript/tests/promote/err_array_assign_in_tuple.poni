fun init() {
    var arr = (123, [1.0, 2.0, 3.0]);

    var second = (456, [4, 5, 6]);

    // This one is tricky because we have to have the logic in the typechecker
    // for tuples as well.
    
    //? Invalid promotion from (int, Array[int]) to (int, Array[float]).
    arr = second;

    print(arr.1[0]);
    print(arr.1[1]);
    print(arr.1[2]);
}