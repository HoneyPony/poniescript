class Horse {
    var name = "twilight";
}

fun print_horse(x: Horse?) {
    var x = x else { print("nil"); return; };
    print(x.name);
}

fun print_strbuf(x: StrBuf?) {
    var x = x else { print("nil"); return; };
    print(x);
}

fun pr(tup: (Horse?, StrBuf?)) {
    print_horse (tup.0);
    print_strbuf(tup.1);
}

fun init() {
    // This is 'ez' version of the similar test, because the array gets to know
    // all of these guys are the same type ahead-of-time, which is very helpful.
    var a: (Horse?, StrBuf?) = (nil        , nil           );
    var b: (Horse?, StrBuf?) = (new Horse{}, nil           );
    var c: (Horse?, StrBuf?) = (nil        , "Hello"       );
    var d: (Horse?, StrBuf?) = (nil        , str("Goodbye"));

    var array = [a, b, c, d];

    //! nil
    //! nil
    pr(array[0]);
    //! twilight
    //! nil
    pr(array[1]);
    //! nil
    //! Hello
    pr(array[2]);
    //! nil
    //! Goodbye
    pr(array[3]);
}