var tex_horse: Texture2D = load_texture("horse.png");
var horse = new Horse{};

var WHITE: vec4 = (1, 1, 1, 1);

fun wave(x: float) -> float {
    while x > 2 {
        x -= 2;
    }
    if x > 1 {
        x = 2 - x;
    }
    return 2 * (3 * x * x - 2 * x * x * x) - 1;
}

class Horse {
    var position: vec2 = (0, 0);
    var theta: float = 0;
    
    fun get_input() -> vec2 {
        var xy = (0.0, 0.0);

        if is_key_down(K_LEFT) { xy.x = -1; }
        if is_key_down(K_RIGHT) { xy.x = 1; }
        if is_key_down(K_UP) { xy.y = -1; }
        if is_key_down(K_DOWN) { xy.y = 1; }

        xy
    }

    fun update() {
        var velocity = get_input();

        var mul = 1000 * get_frame_time();
        // TODO: Implement vector multiplication
        velocity.x *= mul;
        velocity.y *= mul;

        position += velocity;


        for i in 0..100 {
            var i: float = i;
            var s = 0.2;
            draw_texture(tex_horse, position + (i * s * 100, i * s * 20 + wave(theta + i * 0.2) * 30.0), WHITE);
        }
        theta += get_frame_time() * 0.8;
        while theta > 2 { theta -= 2; }
    }
}



fun update() {
    var RED = (1.0, 0.0, 0.0, 1.0);
    var GREEN = (0.0, 1.0, 0.0, 1.0);
    var BLUE = (0.0, 0.0, 1.0, 1.0);
    var GRAY = (0.2, 0.2, 0.2, 1.0);

    clear_background(GRAY);
    horse.update();

    //draw_texture(horse, (40, 40), WHITE);

    // draw_line((40, 40), (100, 200), 15, BLUE);
