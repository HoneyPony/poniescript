fun init() {
    var a = 10;
    var b = 20;
    var c = 10;

    print(a == b); //! false
    print(a != b); //! true

    print(a == c); //! true
    print(a != c); //! false

    var x = 15.0;
    var y = 15.02;
    var z = 15.0;

    // TODO: How should NaN's compare in PonieScript?
    print(x == y); //! false
    print(x != y); //! true

    print(x == z); //! true
    print(x != z); //! false
}